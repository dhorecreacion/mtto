# ============================================================
# Plantilla de variables de entorno — copiar a .env y completar
# ============================================================

# --- Django ---
# DEBUG=True en desarrollo, False en producción
DEBUG=True
# Generar una nueva con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave-en-produccion
# Hosts permitidos, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DB_NAME=mttodb
DB_USER=cvida
DB_PASSWORD=cambia-esta-password
DB_HOST=db
DB_PORT=5432

# --- Superusuario inicial (se crea automáticamente al arrancar) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@ejemplo.com
DJANGO_SUPERUSER_PASSWORD=cambia-esta-password

# ============================================================
# Solo en PRODUCCIÓN (DEBUG=False) — orígenes permitidos del frontend
# ============================================================
# CORS_ALLOWED_ORIGINS=https://mtto.tudominio.com
# CSRF_TRUSTED_ORIGINS=https://mtto.tudominio.com
# SECURE_SSL_REDIRECT=True
