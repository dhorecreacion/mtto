# ============================================================
# Plantilla de variables de entorno — copiar a .env y completar
# ============================================================

# --- Django ---
# DESARROLLO: DEBUG=True   (muestra errores, útil al programar)
# PRODUCCIÓN: DEBUG=False  (oculta errores, más seguro)
DEBUG=True

# Generar una nueva con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave-en-produccion

# En LAN se deja * para aceptar cualquier IP de la red.
ALLOWED_HOSTS=*

# Cifrado HTTPS. En LAN interna se deja False (HTTP simple).
# Solo True si configuras certificados en nginx.
USE_HTTPS=False

# --- PostgreSQL ---
DB_NAME=mttodb
DB_USER=cvida
DB_PASSWORD=cambia-esta-password
DB_HOST=db
DB_PORT=5432

# --- Superusuario inicial (se crea automáticamente al arrancar) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@ejemplo.com
DJANGO_SUPERUSER_PASSWORD=cambia-esta-password

# ============================================================
# Solo si usas el ADMIN de Django en PRODUCCIÓN (DEBUG=False):
# pon la IP del servidor para que funcione el login del admin.
# ============================================================
# CSRF_TRUSTED_ORIGINS=http://192.168.1.50
